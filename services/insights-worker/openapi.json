          },
          "cap_rate_pct": {
            "title": "Cap Rate Pct",
            "type": "number"
          },
          "cash_invested": {
            "title": "Cash Invested",
            "type": "number"
          },
          "cash_on_cash_pct": {
            "title": "Cash On Cash Pct",
            "type": "number"
          },
          "closing_costs": {
            "title": "Closing Costs",
            "type": "number"
          },
          "closing_costs_note": {
            "title": "Closing Costs Note",
