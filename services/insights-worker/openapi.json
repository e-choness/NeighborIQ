              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dscr"
          },
          "effective_monthly_income": {
            "title": "Effective Monthly Income",
            "type": "number"
          },
          "gross_monthly_income": {
            "title": "Gross Monthly Income",
            "type": "number"
          },
          "gross_yield_pct": {
            "title": "Gross Yield Pct",
            "type": "number"
          },
          "insurance_premium": {
            "title": "Insurance Premium",
            "type": "number"
          },
          "monthly_cash_flow": {
            "title": "Monthly Cash Flow",
            "type": "number"
          },
          "monthly_expenses": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Monthly Expenses",
            "type": "object"
          },
          "monthly_mortgage_payment": {
            "title": "Monthly Mortgage Payment",
            "type": "number"
          },
          "monthly_operating_expenses": {
            "title": "Monthly Operating Expenses",
            "type": "number"
          },
          "mortgage_principal": {
            "title": "Mortgage Principal",
            "type": "number"
          },
          "noi_annual": {
            "title": "Noi Annual",
            "type": "number"
          },
          "principal_paydown_year1": {
            "title": "Principal Paydown Year1",
            "type": "number"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "down_payment",
          "insurance_premium",
          "mortgage_principal",
          "monthly_mortgage_payment",
          "closing_costs",
          "closing_costs_note",
          "cash_invested",
          "gross_monthly_income",
          "effective_monthly_income",
          "monthly_expenses",
          "monthly_operating_expenses",
          "noi_annual",
          "monthly_cash_flow",
          "annual_cash_flow",
          "cap_rate_pct",
          "gross_yield_pct",
          "cash_on_cash_pct",
          "dscr",
          "break_even_rent",
          "principal_paydown_year1",
          "warnings"
        ],
        "title": "CashFlowResult",
        "type": "object"
      },
      "CashFlowSummary": {
        "properties": {
          "inputs": {
            "$ref": "#/components/schemas/CashFlowInput"
          },
          "result": {
            "$ref": "#/components/schemas/CashFlowResult"
          }
        },
        "required": [
          "inputs",
          "result"
        ],
        "title": "CashFlowSummary",
        "type": "object"
      },
      "Comp": {
        "properties": {
          "community": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Community"
          },
          "distance_m": {
