          },
          "price_low": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Low"
          },
          "rent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RentEstimate"
              },
              {
                "type": "null"
              }
            ]
