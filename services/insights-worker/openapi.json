{
  "components": {
    "schemas": {
      "CashFlowInput": {
        "properties": {
          "amortization_years": {
            "default": 25,
            "maximum": 35.0,
            "minimum": 5.0,
            "title": "Amortization Years",
            "type": "integer"
          },
          "city": {
            "default": "",
            "title": "City",
            "type": "string"
          },
          "closing_costs": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override; default = land transfer tax estimate + $2,000 legal/inspection",
            "title": "Closing Costs"
          },
          "condo_fee_monthly": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Condo Fee Monthly",
            "type": "number"
          },
          "down_payment_pct": {
            "default": 20.0,
            "maximum": 100.0,
            "minimum": 5.0,
            "title": "Down Payment Pct",
            "type": "number"
          },
          "insurance_monthly": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Insurance Monthly",
            "type": "number"
          },
          "interest_rate_pct": {
            "default": 4.5,
            "description": "Fixed rate, e.g. 4.5 for 4.5%",
            "maximum": 25.0,
            "minimum": 0.0,
            "title": "Interest Rate Pct",
            "type": "number"
          },
          "maintenance_pct": {
            "default": 5.0,
            "description": "Share of rent reserved for repairs",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Maintenance Pct",
            "type": "number"
          },
          "management_pct": {
            "default": 0.0,
            "description": "Property manager fee, share of rent",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Management Pct",
            "type": "number"
          },
          "monthly_rent": {
            "minimum": 0.0,
            "title": "Monthly Rent",
            "type": "number"
          },
          "other_income_monthly": {
            "default": 0.0,
            "description": "Parking, storage, laundry\u2026",
            "minimum": 0.0,
            "title": "Other Income Monthly",
            "type": "number"
          },
          "price": {
            "description": "Purchase price, CAD",
            "exclusiveMinimum": 0.0,
            "title": "Price",
            "type": "number"
          },
          "property_tax_annual": {
            "default": 0.0,
            "minimum": 0.0,
            "title": "Property Tax Annual",
            "type": "number"
          },
          "vacancy_pct": {
            "default": 4.0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Vacancy Pct",
            "type": "number"
          }
        },
        "required": [
          "price",
          "monthly_rent"
        ],
        "title": "CashFlowInput",
        "type": "object"
      },
      "CashFlowResult": {
        "properties": {
          "annual_cash_flow": {
            "title": "Annual Cash Flow",
            "type": "number"
          },
          "break_even_rent": {
