  "paths": {
    "/api/v1/communities": {
      "get": {
        "description": "List neighbourhoods with aggregated statistics.",
        "operationId": "list_communities_api_v1_communities_get",
        "parameters": [
          {
            "description": "Filter by city",
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by city",
              "title": "City"
            }
          },
          {
            "description": "Filter by region",
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by region",
              "title": "Region"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Communities Api V1 Communities Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Communities",
        "tags": [
          "communities"
        ]
      }
    },
    "/api/v1/communities/{community_id}/stats": {
      "get": {
        "description": "Get aggregated statistics for a neighbourhood.",
        "operationId": "get_community_stats_api_v1_communities__community_id__stats_get",
        "parameters": [
          {
            "in": "path",
            "name": "community_id",
            "required": true,
            "schema": {
              "title": "Community Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Community Stats Api V1 Communities  Community Id  Stats Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Community Stats",
        "tags": [
          "communities"
        ]
      }
    },
