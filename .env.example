# Copy to .env and edit. Never commit .env.

# Database
POSTGRES_DB=house_discovery
POSTGRES_USER=neighboriq
POSTGRES_PASSWORD=change-me

# Public hostname (production overlay only)
DOMAIN=neighboriq.example

# Auth — operators: these emails get role=admin when they sign up
ADMIN_EMAILS=you@example.com
# RS256 keys (PEM, newlines as \n). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Leave empty in development: the API then generates and stores a dev key pair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SECURE_COOKIES=1

# Ingestion
FEED_ALLOWED_HOSTS=            # https hosts allowed for partner listing feeds
LISTING_FEED_URL=              # schedules a nightly feed crawl when set

# Insights
ML_PREDICTIONS_ENABLED=0       # show XGBoost estimates once backtest metrics are acceptable
NARRATIVE_PROVIDER=local       # local | azure
