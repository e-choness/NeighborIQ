# Production edge: automatic HTTPS (Let's Encrypt) for $DOMAIN, then the frontend
# container, which serves the SPA and proxies /api to the api service.
{$DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy frontend:80
}
